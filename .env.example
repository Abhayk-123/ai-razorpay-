DATABASE_URL=sqlite:///./data/recoverpilot.db
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
# Used in magic-link emails (ngrok / public origin). Defaults to API_BASE_URL.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Accelerate scheduled retries for local demos (hours / scale)
DEMO_TIME_SCALE=60
WORKER_POLL_SECONDS=2
RETRY_COST_INR=2.5

# Demo merchant (change before any shared deploy)
DEMO_MERCHANT_ID=mch_demo_001
DEMO_MERCHANT_NAME=Demo Merchant
DEMO_API_KEY=rp_demo_key_change_me
DEMO_WEBHOOK_SECRET=whsec_demo_change_me

# Razorpay Test Mode (see docs/RAZORPAY_TEST_MODE.md)
# When set, webhook HMAC is required
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# USE_RAZORPAY_PAYMENT_LINKS=false
